generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum PhaseType {
  PLANNING
  REQUIREMENTS
  FUNCTIONAL_DESIGN
  SCREEN_DESIGN
  DB_DESIGN
  DETAILED_DESIGN
  TEST_DESIGN
  IMPLEMENTATION_CHECKLIST
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  NEEDS_REVIEW
}

enum DeliverableFormat {
  STRUCTURED_LIST
  ER_DIAGRAM
  WIREFRAME
  CHECKLIST
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases            Phase[]
  consistencyChecks ConsistencyCheck[]

  @@index([userId])
}

model Phase {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      PhaseType
  order     Int
  status    PhaseStatus @default(NOT_STARTED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  chatMessages ChatMessage[]
  deliverable  Deliverable?

  @@unique([projectId, type])
  @@index([projectId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  phaseId   String
  phase     Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([phaseId])
}

model Deliverable {
  id        String            @id @default(uuid())
  phaseId   String            @unique
  phase     Phase             @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  format    DeliverableFormat
  content   Json
  version   Int               @default(1)
  isFinal   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ConsistencyCheck {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resultJson Json
  createdAt  DateTime @default(now())

  @@index([projectId])
}
